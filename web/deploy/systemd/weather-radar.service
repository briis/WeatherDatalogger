[Unit]
Description=Vejret — fetch DMI radar and render map frames
Documentation=https://github.com/briis/WeatherDatalogger/tree/main/web#radar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=weatherradar
Group=weatherradar
ExecStart=/opt/weather-web/radar-venv/bin/python3 /opt/weather-web/radar/radar_worker.py --config /etc/weather-web/radar.ini
TimeoutStartSec=180
Nice=10
# Hardening — it only needs the network and its output directory
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/weather-web/radar
SyslogIdentifier=weather-radar
