[Unit]
Description=Open-Meteo → MQTT Forecast Datalogger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weatherdatalogger
Group=weatherdatalogger
WorkingDirectory=/opt/weatherdatalogger/openmeteo
ExecStart=/opt/weatherdatalogger/openmeteo/venv/bin/python3 openmeteo_datalogger.py --config /opt/weatherdatalogger/config.ini
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openmeteo-datalogger

[Install]
WantedBy=multi-user.target
